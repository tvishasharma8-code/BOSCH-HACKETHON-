# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui

# Gemini (Google AI Studio). LLM_API_KEY above is kept for whoever uses it;
# the agent's provider reads GEMINI_API_KEY.
GEMINI_API_KEY=
IZ_LLM_PROVIDER=gemini
ACTION_API_URL=http://127.0.0.1:8700
